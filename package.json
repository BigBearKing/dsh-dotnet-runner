{
  "name": "dsh-dotnet-runner",
  "version": "1.0.3",
  "description": "DeepSeek Harness plugin: detect .NET projects in the workspace and run/stop them from a floating button.",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dotnet",
    "dotnet-run",
    "plugin"
  ],
  "homepage": "https://github.com/BigBearKing/dsh-dotnet-runner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BigBearKing/dsh-dotnet-runner.git"
  },
  "bugs": {
    "url": "https://github.com/BigBearKing/dsh-dotnet-runner/issues"
  },
  "author": "BigBearKing",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
